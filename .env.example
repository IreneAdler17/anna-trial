# Copy to .env for local testing only. On Netlify these go in
# Site configuration → Environment variables. Never commit real values.

# Supabase (same project as the pipeline)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Anthropic — reads double-tap screenshots and picks each night's edit
ANTHROPIC_API_KEY=
ANNA_MODEL=claude-sonnet-5

# Web push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Your admin key — used to add friends and see trial numbers
ADMIN_KEY=

# The iCloud link to the Anna Shortcut you build on your iPhone
# Optional: the site already has the current link built in
# SHORTCUT_URL=

# Pipeline table. Defaults already match pipeline_products, so leave these out
# unless the pipeline's columns change.
# POOL_TABLE=pipeline_products
# POOL_COL_ID=url_key
# POOL_COL_NAME=title
# POOL_COL_URL=product_url
# POOL_COL_IN_STOCK=available

# Local testing: set to 1 to use config/sample_pool.json instead of Supabase
ANNA_MOCK=0

# Cut-outs (the Behind and Product pages need the background removed from the photo).
# A remove.bg API key: https://www.remove.bg/api. Without it every piece falls back to the
# Landscape or Printed tail page, which is designed to happen.
# CUTOUT_API_KEY=
# CUTOUT_MAX_PER_BUILD=14
